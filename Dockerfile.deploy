# Image autonome : le contexte
# de build est ce repo seul (checkout GitHub), contrairement à Dockerfile qui
# suppose un contexte monorepo pour le dev local.
#
# go.mod référence core par `replace => ../core` tant que core n'est pas publié
# comme module versionné : on le clone donc à côté du code, à la référence
# CORE_REF (branche ou tag). Une fois core tagué (vX.Y.Z), supprimer le
# `replace` de go.mod puis ce `git clone` : `go build` résoudra core seul, et ce
# fichier deviendra identique à Dockerfile (les deux pourront fusionner).
FROM golang:1.24 AS build
ARG CORE_REF=main
WORKDIR /src
RUN git clone --depth 1 --branch "${CORE_REF}" https://github.com/OpenHexa-fr/core.git core
WORKDIR /src/essence-back
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/essence-back ./cmd/essence-back

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/essence-back /essence-back
EXPOSE 8001
ENTRYPOINT ["/essence-back"]
