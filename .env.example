ES_URL=http://localhost:9200
ES_USER=openhexa_essence
ES_PASSWORD=changeme
# Préfixe de tout ce que l'application crée dans Elasticsearch :
#   <préfixe>-stations (index) et <préfixe>-prix-historique (data stream).
ES_INDEX_PREFIX=openhexa-essence
# Clients 8.x face à un serveur Elasticsearch 9.x (stack partagée du NAS).
ELASTIC_CLIENT_APIVERSIONING=true
DATA_GOUV_LIVE_URL=https://data.economie.gouv.fr/api/explore/v2.1/catalog/datasets/prix-des-carburants-en-france-flux-instantane-v2/exports/json
POLLING_INTERVAL_SECONDS=86400
SEARCH_REFRESH_TTL_SECONDS=600
# Durée de conservation de l'historique des prix (ex. 730d). Vide : illimitée.
HISTORY_RETENTION=
# Port d'écoute HTTP (8001 par défaut).
# PORT=8001
